{
  "manifest_version": 3,
  "name": "Domain Tab Grouper",
  "version": "1.0.0",
  "description": "Automatically groups tabs by website. No patterns to set up.",
  "minimum_chrome_version": "102",
  "homepage_url": "https://github.com/salkz/domain-tab-grouper",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Domain Tab Grouper",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/popup.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
